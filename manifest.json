{
  "name": "Detekta – A Metal Detecting App",
  "short_name": "Detekta",
  "id": "io.github.cornishman2.detekta",
  "description": "Detekta is a field app for metal detectorists. Start a dig with one tap, record your walk, log signals and finds on the map, scout for iron, compare satellite, LiDAR and old Ordnance Survey maps, and back up your finds — works without signal.",
  "lang": "en-GB",
  "start_url": "/gps/",
  "scope": "/gps/",
  "display": "standalone",
  "orientation": "portrait",
  "categories": [
    "navigation",
    "utilities"
  ],
  "permissions": [
    "geolocation"
  ],
  "features": [
    {
      "name": "geolocation"
    }
  ],
  "background_color": "#f3f4f6",
  "theme_color": "#1d4ed8",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
